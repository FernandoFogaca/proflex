
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {


      match /agendamentos/{agendamentoId} {
     allow read, write: if request.auth != null
     && request.auth.uid == userId;
}

      // Somente o dono pode consultar seu perfil
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // Cadastro do próprio usuário
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid', 'nome', 'cpf', 'email', 'tipoPerfil',
          'whatsapp', 'telefone', 'endereco',
          'profissao', 'registroProfissional',
          'nomeClinica', 'cnpj', 'enderecoClinica',
          'whatsappClinica', 'criadoEm', 'atualizadoEm'
        ])
        && request.resource.data.tipoPerfil in [
          'autonomo', 'clinica', 'hibrido'
        ];

      allow update, delete: if false;

      // Caixinha dos pacientes deste usuário
      match /pacientes/{pacienteId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Bloqueia outros caminhos
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
